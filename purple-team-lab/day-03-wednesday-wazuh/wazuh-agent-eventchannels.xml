<!--
Add this block to C:\Program Files (x86)\ossec-agent\ossec.conf
INSIDE the <ossec_config>...</ossec_config> tags
AFTER the existing <localfile> blocks for Application/System/Security

After saving, run: Restart-Service WazuhSvc
-->

<localfile>
  <location>Microsoft-Windows-Sysmon/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>

<localfile>
  <location>Microsoft-Windows-PowerShell/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>

<localfile>
  <location>Windows PowerShell</location>
  <log_format>eventchannel</log_format>
</localfile>
