<!--
Wazuh local_rules.xml — Purple Lab custom rules
Save as: /var/ossec/etc/rules/local_rules.xml on the Wazuh manager
After editing: systemctl restart wazuh-manager

These are the Wazuh equivalents of the Sigma rules in this folder.
Custom rule IDs start at 100000 (per Wazuh conventions).
-->

<group name="windows,attack,purple_lab,">

  <!-- ===== Rule 1: Kerberoasting (T1558.003) ===== -->
  <rule id="100100" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <field name="win.eventdata.targetUserName" negate="yes">\$$</field>
    <field name="win.eventdata.targetUserName" negate="yes">^krbtgt$</field>
    <description>Kerberoasting: RC4 service ticket requested for non-machine account ($(win.eventdata.targetUserName))</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>credential_access,kerberos,</group>
  </rule>

  <!-- ===== Rule 2: AS-REP Roasting (T1558.004) ===== -->
  <rule id="100101" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.preAuthType">^0$</field>
    <field name="win.eventdata.targetUserName" negate="yes">\$$</field>
    <description>AS-REP Roasting: TGT issued to account without pre-authentication ($(win.eventdata.targetUserName))</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>credential_access,kerberos,</group>
  </rule>

  <!-- ===== Rule 3a: Single failed logon (base for correlation) ===== -->
  <rule id="100102" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.subStatus">^0xc000006a$</field>
    <description>Failed logon — bad password</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- ===== Rule 3b: Password spray correlation ===== -->
  <rule id="100103" level="12" frequency="10" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <same_source_ip />
    <different_user />
    <description>Password spray detected: 10+ failed logons across distinct users from same source in 60s</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>credential_access,password_spray,</group>
  </rule>

  <!-- ===== Rule 4: DCSync (T1003.006) ===== -->
  <rule id="100104" level="14">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties">1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2</field>
    <field name="win.eventdata.subjectUserName" negate="yes">\$$</field>
    <field name="win.eventdata.subjectUserName" negate="yes">^MSOL_</field>
    <description>DCSync attack: Replication GUID accessed by non-machine account ($(win.eventdata.subjectUserName))</description>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>credential_access,dcsync,</group>
  </rule>

  <!-- ===== Rule 5: BloodHound LDAP enumeration (T1087.002) ===== -->
  <!-- Detects high volume of LDAP queries from one source in short time -->
  <rule id="100105" level="6">
    <if_sid>61603</if_sid>  <!-- Sysmon network connection -->
    <field name="win.eventdata.destinationPort">^389$|^636$</field>
    <description>LDAP query — base rule for enumeration correlation</description>
    <group>discovery,</group>
  </rule>
  <rule id="100106" level="10" frequency="50" timeframe="60">
    <if_matched_sid>100105</if_matched_sid>
    <same_field>win.eventdata.sourceIp</same_field>
    <description>BloodHound-like LDAP enumeration: 50+ LDAP queries in 60s from same source</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>discovery,bloodhound,</group>
  </rule>

  <!-- ===== Rule 6: Suspicious PowerShell encoded command (T1059.001) ===== -->
  <rule id="100107" level="10">
    <if_sid>61603</if_sid>  <!-- Sysmon process create (Event 1) -->
    <field name="win.eventdata.image">powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(?:e|en|enc|enco|encod|encode|encoded|encodedcommand)\b</field>
    <description>Suspicious PowerShell with encoded command: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>execution,powershell,</group>
  </rule>

  <!-- ===== Rule 7: LSASS process access (T1003.001) ===== -->
  <rule id="100108" level="13">
    <if_sid>61609</if_sid>  <!-- Sysmon ProcessAccess Event 10 -->
    <field name="win.eventdata.targetImage">lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x10|0x40|0x1010|0x1410|0x1438|0x143a|0x1fffff</field>
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(svchost|lsass|csrss|services|wininit)\.exe$</field>
    <description>Suspicious LSASS access (Mimikatz pattern): $(win.eventdata.sourceImage) -> lsass.exe</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass,</group>
  </rule>

  <!-- ===== Rule 8: Domain Admins group membership change (T1098) ===== -->
  <rule id="100109" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
    <field name="win.eventdata.targetUserName">^Domain Admins$|^Enterprise Admins$|^Schema Admins$</field>
    <description>Privileged group membership change: $(win.eventdata.subjectUserName) added a member to $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>persistence,privilege_escalation,</group>
  </rule>

  <!-- ===== Rule 9: Service creation (T1543.003) ===== -->
  <rule id="100110" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)(\\users\\|\\appdata\\|\\temp\\|\\programdata\\|powershell|cmd\.exe|rundll32)</field>
    <description>Suspicious service creation: $(win.eventdata.serviceName) -> $(win.eventdata.imagePath)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <group>persistence,service_install,</group>
  </rule>

  <!-- ===== Rule 10: Scheduled task creation (T1053.005) ===== -->
  <rule id="100111" level="8">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4698$</field>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)(powershell|cmd\.exe|rundll32|mshta|wscript|cscript)</field>
    <description>Suspicious scheduled task created: $(win.eventdata.taskName)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

  <!-- ===== Rule 11: WMI lateral movement (T1047) ===== -->
  <rule id="100112" level="10">
    <if_sid>61603</if_sid>  <!-- Sysmon Event 1 -->
    <field name="win.eventdata.parentImage">WmiPrvSE\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell|cmd\.exe|rundll32|mshta)</field>
    <description>Possible WMI lateral movement: WmiPrvSE.exe spawned $(win.eventdata.image)</description>
    <mitre>
      <id>T1047</id>
    </mitre>
    <group>lateral_movement,wmi,</group>
  </rule>

  <!-- ===== Rule 12: Local administrator account creation (T1136.001) ===== -->
  <rule id="100113" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>New local user account created: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>persistence,account_creation,</group>
  </rule>

</group>
